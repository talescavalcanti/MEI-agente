# Copie para .env.local e preencha. Nunca versione o .env.local.

# Supabase (service role key: só no servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do agendador (pg_cron chama /api/cron/* com ele)
CRON_SECRET=

# Assinatura do JWT de sessão. Trocar derruba todas as sessões.
SESSION_SECRET=

# Modelo do agente na Featherless (API compatível com OpenAI)
FEATHERLESS_API_KEY=
# Id do modelo na Featherless. Precisa suportar function calling e streaming.
AGENTE_MODELO=

# Teto de tokens por MEI por dia (opcional; padrão 400000)
AGENTE_LIMITE_DIARIO_TOKENS=

# Meta: Instagram e WhatsApp (todas opcionais; sem elas o webhook fica desligado)
# Id do app no painel da Meta for Developers
META_APP_ID=
# App Secret: confere a assinatura dos eventos em /api/meta/webhook
META_APP_SECRET=
# Token de acesso da conta (para enviar mensagens; ainda não usado)
META_ACCESS_TOKEN=
# Id da conta profissional do Instagram
INSTAGRAM_ACCOUNT_ID=
# Texto livre, igual ao "Verify token" cadastrado no webhook da Meta
META_WEBHOOK_VERIFY_TOKEN=
