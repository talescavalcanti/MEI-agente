# Copie para .env.local e preencha. Nunca versione o .env.local.

# Supabase (service role key: só no servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app, sem barra no fim (ex.: https://mei-agente.vercel.app)
APP_URL=

# Segredo do agendador (pg_cron chama /api/cron/* com ele)
CRON_SECRET=

# Assinatura do JWT de sessão. Trocar derruba todas as sessões.
SESSION_SECRET=

# Modelo do agente na Featherless (API compatível com OpenAI)
FEATHERLESS_API_KEY=rc_0d88d95107dac9453f1ab9f1d77f8574c0dfbe20835d2e760c03c10b22637341
# Id do modelo na Featherless. Precisa suportar function calling e streaming.
AGENTE_MODELO=

# Teto de tokens por MEI por dia (opcional; padrão 400000)
AGENTE_LIMITE_DIARIO_TOKENS=
